{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CLIPS",
  "scopeName": "source.clips",
  "fileTypes": ["clp", "clips"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constructs" },
    { "include": "#globals" },
    { "include": "#multifield-variables" },
    { "include": "#variables" },
    { "include": "#keywords" },
    { "include": "#slot-keywords" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.clips",
          "match": ";.*$"
        },
        {
          "name": "comment.block.clips",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.clips",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.clips",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.clips",
      "match": "(?<![\\w?$])-?\\d+\\.?\\d*(?:[eE][+-]?\\d+)?(?![\\w])"
    },
    "constructs": {
      "patterns": [
        {
          "match": "(\\()\\s*(deffacts|deftemplate|defrule|deffunction|defglobal|defclass|definstances|defmessage-handler|defmodule|defgeneric|defmethod)\\b",
          "captures": {
            "1": { "name": "punctuation.section.parens.begin.clips" },
            "2": { "name": "keyword.control.construct.clips" }
          }
        }
      ]
    },
    "globals": {
      "name": "variable.other.global.clips",
      "match": "\\?\\*[A-Za-z0-9_+\\-*/.<>=]+\\*"
    },
    "multifield-variables": {
      "name": "variable.parameter.multifield.clips",
      "match": "\\$\\?[A-Za-z0-9_+\\-*/.<>=]*"
    },
    "variables": {
      "name": "variable.other.clips",
      "match": "\\?[A-Za-z0-9_+\\-*/.<>=]*"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.fact-function.clips",
          "match": "(?<=\\()\\s*(assert|retract|modify|modify-instance|duplicate|duplicate-instance|make-instance|unmake-instance|send)(?=[\\s)])"
        },
        {
          "name": "keyword.control.conditional.clips",
          "match": "(?<=\\()\\s*(if|then|else|elif|while|do|loop-for-count|switch|case|default)(?=[\\s)])"
        },
        {
          "name": "keyword.other.io.clips",
          "match": "(?<=\\()\\s*(printout|format|read|readline|open|close|flush|remove|rename)(?=[\\s)])"
        },
        {
          "name": "keyword.other.function.clips",
          "match": "(?<=\\()\\s*(bind|progn|return|break|create\\$|length\\$|nth\\$|delete\\$|delete-member\\$|insert\\$|replace\\$|explode\\$|implode\\$|subseq\\$|first\\$|rest\\$|member\\$|subsetp|str-cat|str-compare|str-index|str-length|sub-string|upcase|lowcase|sym-cat|gensym\\*|integer|float|string|symbol|instance-name|instance-address|instance-addressp|instance-namep|integerp|floatp|numberp|stringp|symbolp|lexemep|multifieldp|evenp|oddp)(?=[\\s)])"
        },
        {
          "name": "keyword.operator.logical.clips",
          "match": "(?<=\\()\\s*(and|or|not|test|exists|forall|logical)(?=[\\s)])"
        }
      ]
    },
    "slot-keywords": {
      "name": "storage.modifier.slot.clips",
      "match": "\\b(slot|multislot|single-slot|default|default-dynamic|type|allowed-symbols|allowed-strings|allowed-numbers|allowed-integers|allowed-floats|allowed-values|allowed-instance-names|allowed-classes|cardinality|pattern-match|range|storage|access|source|propagation|visibility|create-accessor|override-message|is-a|role|declare|salience|node-index-hash|auto-focus)\\b"
    },
    "constants": {
      "name": "constant.language.clips",
      "match": "\\b(TRUE|FALSE|nil|crlf|t)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.clips",
          "match": "=>"
        },
        {
          "name": "keyword.operator.backward.clips",
          "match": "<-"
        },
        {
          "name": "keyword.operator.constraint.clips",
          "match": "[&|~]"
        }
      ]
    }
  }
}
