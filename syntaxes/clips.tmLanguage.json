{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CLIPS",
  "scopeName": "source.clips",
  "fileTypes": ["clp", "clips"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constructs" },
    { "include": "#globals" },
    { "include": "#multifield-variables" },
    { "include": "#variables" },
    { "include": "#keywords" },
    { "include": "#slot-keywords" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#symbols" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.clips",
          "match": ";.*$"
        },
        {
          "name": "comment.block.clips",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.clips",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.clips",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.clips",
      "match": "(?<![\\w?$])-?\\d+\\.?\\d*(?:[eE][+-]?\\d+)?(?![\\w])"
    },
    "constructs": {
      "patterns": [
        {
          "match": "(\\()\\s*(defrule)\\s+([^\\s()]+)",
          "captures": {
            "1": { "name": "punctuation.section.parens.begin.clips" },
            "2": { "name": "keyword.control.construct.clips" },
            "3": { "name": "entity.name.function.rule.clips" }
          }
        },
        {
          "match": "(\\()\\s*(deftemplate)\\s+([^\\s()]+)",
          "captures": {
            "1": { "name": "punctuation.section.parens.begin.clips" },
            "2": { "name": "keyword.control.construct.clips" },
            "3": { "name": "entity.name.type.template.clips" }
          }
        },
        {
          "match": "(\\()\\s*(deffunction)\\s+([^\\s()]+)",
          "captures": {
            "1": { "name": "punctuation.section.parens.begin.clips" },
            "2": { "name": "keyword.control.construct.clips" },
            "3": { "name": "entity.name.function.clips" }
          }
        },
        {
          "match": "(\\()\\s*(deffacts|defglobal|defclass|definstances|defmessage-handler|defmodule|defgeneric|defmethod)\\b",
          "captures": {
            "1": { "name": "punctuation.section.parens.begin.clips" },
            "2": { "name": "keyword.control.construct.clips" }
          }
        }
      ]
    },
    "globals": {
      "name": "variable.other.global.clips",
      "match": "\\?\\*[A-Za-z0-9_+\\-*/.<>=]+\\*"
    },
    "multifield-variables": {
      "name": "variable.parameter.multifield.clips",
      "match": "\\$\\?[A-Za-z0-9_+\\-*/.<>=]*"
    },
    "variables": {
      "name": "variable.other.clips",
      "match": "\\?[A-Za-z0-9_+\\-*/.<>=]*"
    },
    "keywords": {
      "patterns": [
        {
          "name": "support.function.fact.clips",
          "match": "(?<=\\()\\s*(active-message-duplicate-instance|active-message-modify-instance|delayed-do-for-all-instances|active-initialize-instance|message-duplicate-instance|active-duplicate-instance|delayed-do-for-all-facts|instance-name-to-symbol|message-modify-instance|symbol-to-instance-name|active-modify-instance|get-definstances-list|active-make-instance|do-for-all-instances|get-fact-duplication|set-fact-duplication|definstances-module|initialize-instance|duplicate-instance|find-all-instances|get-deffacts-list|list-definstances|restore-instances|do-for-all-facts|bload-instances|bsave-instances|deffacts-module|delete-instance|do-for-instance|fact-slot-names|fact-slot-value|instance-existp|modify-instance|unmake-instance|find-all-facts|load-instances|ppdefinstances|save-instances|undefinstances|any-instancep|fact-relation|find-instance|get-fact-list|list-deffacts|make-instance|bload-facts|do-for-fact|fact-existp|fact-index|load-facts|ppdeffacts|ppinstance|save-facts|str-assert|undeffacts|any-factp|duplicate|find-fact|instances|retract|assert|modify|facts|send)(?=[\\s)])"
        },
        {
          "name": "keyword.control.conditional.clips",
          "match": "(?<=\\()\\s*(object-pattern-match-delay|loop-for-count|default|foreach|progn\\$|return|switch|break|progn|while|bind|case|halt|if)(?=[\\s)])"
        },
        {
          "name": "support.function.io.clips",
          "match": "(?<=\\()\\s*(unget-char|get-char|printout|readline|println|format|remove|rename|close|flush|print|open|read)(?=[\\s)])"
        },
        {
          "name": "support.function.misc.clips",
          "match": "(?<=\\()\\s*(get-sequence-operator-recognition|set-sequence-operator-recognition|get-dynamic-constraint-checking|set-dynamic-constraint-checking|get-defmessage-handler-list|get-function-restrictions|list-defmessage-handlers|get-method-restrictions|get-salience-evaluation|set-salience-evaluation|message-handler-existp|override-next-handler|call-specific-method|get-deffunction-list|get-deftemplate-list|override-next-method|ppdefmessage-handler|slot-direct-replace\\$|undefmessage-handler|get-defgeneric-list|slot-allowed-values|slot-direct-accessp|slot-direct-delete\\$|slot-direct-insert\\$|class-superclasses|deffunction-module|deftemplate-module|get-current-module|get-defglobal-list|get-defmethod-list|get-defmodule-list|set-current-module|call-next-handler|clear-focus-stack|defgeneric-module|get-defclass-list|get-reset-globals|list-deffunctions|list-deftemplates|set-reset-globals|call-next-method|class-subclasses|defglobal-module|get-defrule-list|instance-address|list-defgenerics|list-focus-stack|list-watch-items|operating-system|slot-cardinality|class-abstractp|class-reactivep|constructs-to-c|defclass-module|get-focus-stack|list-defclasses|list-defglobals|list-defmethods|list-defmodules|preview-generic|primitives-info|rule-complexity|show-defglobals|browse-classes|defrule-module|describe-class|refresh-agenda|slot-initablep|slot-writablep|instance-name|list-defrules|ppdeffunction|ppdeftemplate|slot-replace\\$|undeffunction|undeftemplate|class-existp|conserve-mem|dependencies|get-strategy|mem-requests|ppdefgeneric|preview-send|print-region|remove-break|slot-delete\\$|slot-insert\\$|slot-publicp|slot-sources|undefgeneric|class-slots|clear-error|dribble-off|dynamic-get|dynamic-put|ppdefglobal|ppdefmethod|ppdefmodule|release-mem|show-breaks|slot-existp|slot-facets|superclassp|undefglobal|undefmethod|dependents|dribble-on|init-slots|local-time|ppdefclass|show-joins|slot-range|slot-types|undefclass|get-error|get-focus|pop-focus|ppdefrule|set-break|set-error|subclassp|undefrule|mem-used|show-fht|show-fpn|show-opn|apropos|gensym\\*|gm-time|matches|options|refresh|unwatch|agenda|batch\\*|random|rewind|setgen|system|batch|bload|bsave|build|chdir|class|clear|fetch|focus|load\\*|reset|rules|watch|edit|eval|exit|load|save|seed|seek|tell|time|toss|type|void|get|put|run)(?=[\\s)])"
        },
        {
          "name": "support.function.logical.clips",
          "match": "(?<=\\()\\s*(logical|exists|forall|test|and|not|or)(?=[\\s)])"
        },
        {
          "name": "support.function.predicate.clips",
          "match": "(?<=\\()\\s*(external-addressp|instance-addressp|instance-namep|next-handlerp|next-methodp|multifieldp|instancep|integerp|pointerp|lexemep|numberp|stringp|symbolp|floatp|evenp|oddp)(?=[\\s)])"
        },
        {
          "name": "support.function.string.clips",
          "match": "(?<=\\()\\s*(string-to-field|assert-string|str-compare|str-length|sub-string|str-index|lowcase|str-cat|sym-cat|upcase)(?=[\\s)])"
        },
        {
          "name": "support.function.multifield.clips",
          "match": "(?<=\\()\\s*(replace-member\\$|delete-member\\$|intersection\\$|difference\\$|explode\\$|implode\\$|replace\\$|create\\$|delete\\$|expand\\$|insert\\$|length\\$|member\\$|subseq\\$|subsetp|first\\$|union\\$|rest\\$|nth\\$|sort)(?=[\\s)])"
        },
        {
          "name": "support.function.arithmetic.clips",
          "match": "(?<=\\()\\s*(deg-grad|grad-deg|deg-rad|integer|rad-deg|acosh|acoth|acsch|asech|asinh|atan2|atanh|float|log10|round|acos|acot|acsc|asec|asin|atan|cosh|coth|csch|sech|sinh|sqrt|tanh|abs|cos|cot|csc|div|exp|log|max|min|mod|sec|sin|tan|pi)(?=[\\s)])"
        },
        {
          "name": "keyword.operator.arithmetic.clips",
          "match": "(?<=\\()\\s*(\\*\\*|-|\\*|/|\\+)(?=[\\s)])"
        },
        {
          "name": "support.function.comparison.clips",
          "match": "(?<=\\()\\s*(neq|eq)(?=[\\s)])"
        },
        {
          "name": "keyword.operator.comparison.clips",
          "match": "(?<=\\()\\s*(<=|<>|>=|<|=|>)(?=[\\s)])"
        }
      ]
    },
    "slot-keywords": {
      "name": "storage.modifier.slot.clips",
      "match": "\\b(slot|multislot|single-slot|default|default-dynamic|type|allowed-symbols|allowed-strings|allowed-numbers|allowed-integers|allowed-floats|allowed-values|allowed-instance-names|allowed-classes|cardinality|pattern-match|range|storage|access|source|propagation|visibility|create-accessor|override-message|is-a|role|declare|salience|node-index-hash|auto-focus)\\b"
    },
    "constants": {
      "name": "constant.language.clips",
      "match": "\\b(TRUE|FALSE|nil|crlf|t)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.clips",
          "match": "=>"
        },
        {
          "name": "keyword.operator.backward.clips",
          "match": "<-"
        },
        {
          "name": "keyword.operator.constraint.clips",
          "match": "[&|~]"
        }
      ]
    },
    "symbols": {
      "name": "constant.other.symbol.clips",
      "match": "[^\\s();\"?$]+"
    }
  }
}
